# Copie para .env e ajuste. Nunca versione o .env.

# --- Versões fixadas das imagens ---
N8N_VERSION=1.123.98
POSTGRES_VERSION=16.16
NGINX_VERSION=1.31.9-alpine
OLLAMA_VERSION=0.40.16

# --- PostgreSQL ---
# Superusuário do contêiner (usado só na inicialização)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-admin
# Usuário do n8n (database interno "n8n")
N8N_DB_USER=n8n
N8N_DB_PASSWORD=troque-esta-senha-n8n
# Usuário da aplicação (database "plataforma"); use-o na credencial "plataforma" do n8n
PLATAFORMA_DB_USER=plataforma_app
PLATAFORMA_DB_PASSWORD=troque-esta-senha-app

# --- n8n ---
# Gere com: openssl rand -hex 32  (ou qualquer texto longo e aleatório)
N8N_ENCRYPTION_KEY=troque-por-uma-chave-longa-e-aleatoria
GENERIC_TIMEZONE=America/Sao_Paulo
# Porta do editor do n8n no host (mude se a 5678 já estiver em uso)
N8N_EDITOR_PORT=5678

# --- Ollama ---
# Ollama instalado no Windows (usa a GPU sem configurar o Docker):
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama em contêiner (docker compose --profile ollama up -d):
# OLLAMA_BASE_URL=http://ollama:11434

# --- Verificador ---
VERIFICADOR_URL=http://verificador:8000
