ng('base64');\n\nconst passo = $('Próximo passo').first().json.p;\nconst r = $input.first().json;\nconst { message, ...metadados } = r;\nreturn [{ json: { b64: b64({\n  tentativa_id: passo.tentativa_id,\n  ordem: passo.ordem,\n  entrada: passo.requisicao.messages,\n  resposta: message?.content ?? '',\n  metadados,\n}) } }];\n"},"id":"7d07fe5a-19fd-5704-b983-8cc3f792b19f","name":"Prepara turno","type":"n8n-nodes-base.code","typeVersion":2,"position":[1100,-200]},{"parameters":{"operation":"executeQuery","query":"=SELECT api_registrar_turno(convert_from(decode('{{ $json.b64 }}', 'base64'), 'UTF8')::jsonb) AS r","options":{}},"id":"9e3c48aa-66a3-586e-9c3c-608fd04e0df6","name":"Registrar turno","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1320,-200],"credentials":{"postgres":{"id":"plataformaPg0001","name":"plataforma"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"78236986-0c8d-5372-9f0e-b5ece6b2287f","leftValue":"={{ $json.p.acao === 'verificar' }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"f6e6bb02-d82b-554d-a991-44d7231e62ac","name":"É verificação?","type":"n8n-nodes-base.if","typeVersion":2,"position":[880,120]},{"parameters":{"method":"POST","url":"={{ $env.VERIFICADOR_URL }}/verificar","options":{"timeout":"={{ $json.p.timeout_ms }}"},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify($json.p.requisicao) }}"},"id":"59b14f76-7e69-5d63-b79e-c79147cf1582","name":"Verificador","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1100,120],"onError":"continueErrorOutput"},{"parameters":{"jsCode":"const b64 = (o) => Buffer.from(JSON.stringify(o), 'utf8').toString('base64');\n\nconst passo = $('Próximo passo').first().json.p;\nreturn [{ json: { b64: b64({ tentativa_id: passo.tentativa_id, resultado: $input.first().json }) } }];\n"},"id":"f210546a-08f1-5697-a922-f6386f3f8d86","name":"Prepara verificação","type":"n8n-nodes-base.code","typeVersion":2,"position":[1320,60]},{"parameters":{"operation":"executeQuery","query":"=SELECT api_registrar_verificacao(convert_from(decode('{{ $json.b64 }}', 'base64'), 'UTF8')::jsonb) AS r","options":{}},"id":"9a9d929e-1527-5dd9-b3f4-c62babd26dee","name":"Registrar verificação","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1540,60],"credentials":{"postgres":{"id":"plataformaPg0001","name":"plataforma"}}},{"parameters":{"jsCode":"const b64 = (o) => Buffer.from(JSON.stringify(o), 'utf8').toString('base64');\n\n// Falha ou tempo excedido: a tentativa vira \"falha\" e a avaliação continua (RF12, RF23)\nconst passo = $('Próximo passo').first().json.p;\nconst e = $input.first().json.error || {};\nconst texto = [e.message, e.description].filter(Boolean).join(' - ') || JSON.stringify(e);\nconst etapa = passo.acao === 'turno' ? `no turno ${passo.ordem}` : 'na verificação';\nlet erro;\nif (/timeout|ECONNABORTED|ETIMEDOUT/i.test(texto)) {\n  erro = `Tempo máximo de espera excedido ${etapa} (${Math.round(passo.timeout_ms / 1000)} s)`;\n} else {\n  erro = `Falha ${etapa}: ${texto}`;\n}\nreturn [{ json: { b64: b64({ tentativa_id: passo.tentativa_id, erro }) } }];\n"},"id":"4ddffa2b-42c9-5a25-9471-9c586f653a3a","name":"Prepara falha","type":"n8n-nodes-base.code","typeVersion":2,"position":[1320,-40]},{"parameters":{"operation":"executeQuery","query":"=SELECT api_registrar_falha(convert_from(decode('{{ $json.b64 }}', 'base64'), 'UTF8')::jsonb) AS r","options":{}},"id":"7286f1de-5efa-5b25-98e2-68c7e552e1f3","name":"Registrar falha","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1540,-40],"credentials":{"postgres":{"id":"plataformaPg0001","name":"plataforma"}}}],"connections":{"Receber tentativa":{"main":[[{"node":"Tentativa","type":"main","index":0}]]},"Tentativa":{"main":[[{"node":"Próximo passo","type":"main","index":0}]]},"Próximo passo":{"main":[[{"node":"É turno?","type"