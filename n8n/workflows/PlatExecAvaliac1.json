{"updatedAt":"2026-11-18T19:29:25.196Z","createdAt":"2026-11-18T19:21:02.855Z","id":"PlatExecAvaliac1","name":"executar-avaliacao","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"plataforma/avaliacao-executar","responseMode":"responseNode","options":{}},"id":"3125dc9b-2a8d-563a-a428-38d16eb113bf","name":"POST /avaliacoes/:id/executar","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,0],"webhookId":"01a06bb8-b4c2-5beb-a718-9ce81ec2b560"},{"parameters":{"jsCode":"const q = ($input.first().json).query || {};\nconst n = Number(q.id);\n// id inválido vira 0, que não existe (404)\nreturn [{ json: { id: Number.isInteger(n) && n > 0 ? n : 0, query: q } }];\n"},"id":"0bf52fd8-f3d4-5859-9e49-c40df19f295e","name":"Id da avaliação","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,0]},{"parameters":{"operation":"executeQuery","query":"=SELECT api_iniciar_execucao({{ $json.id }}) AS r","options":{}},"id":"37e555b2-5683-503b-861e-70f5a4140d4a","name":"Iniciar execução","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[440,0],"credentials":{"postgres":{"id":"plataformaPg0001","name":"plataforma"}}},{"parameters":{"jsCode":"const id = $('Id da avaliação').first().json.id;\nconst r = $json.r || {};\nconst sai = (status, corpo, iniciar = false) => [{ json: { status, corpo, iniciar, id } }];\nswitch (r.resultado) {\n  case 'ok':\n    return sai(202, { id, status: 'em_execucao', mensagem: 'Execução iniciada. Acompanhe o progresso em GET /avaliacoes/' + id + '.' }, true);\n  case 'nao_encontrada':\n    return sai(404, { erro: 'Avaliação não encontrada.' });\n  case 'ocupado':\n    return sai(409, { erro: `Já existe uma avaliação em execução (id ${r.em_execucao}). Só uma avaliação pode ser executada por vez.`, em_execucao: r.em_execucao });\n  case 'status_invalido':\n    return sai(409, { erro: `A avaliação está com status \"${r.status}\"; só avaliações \"configurada\" podem ser executadas.`, status: r.status });\n  default:\n    return sai(500, { erro: 'Resposta inesperada ao iniciar a execução.' });\n}\n"},"id":"2acc621e-41e4-5e49-ab3e-aa93aaa66a36","name":"Resposta executar","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,0]},{"parameters":{"respondWith":"json","responseBody":"={{ JSON.stringify($json.corpo) }}","options":{"responseCode":"={{ $json.status }}"}},"id":"f7375c48-487c-5a23-b15f-75f88c7b285d","name":"Responder","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[880,0]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"615b0e98-1aae-5bd2-97a9-d4faf159de60","leftValue":"={{ $json.iniciar }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"5a00dac9-50b8-5f57-ab67-b37bd20951aa","name":"Iniciou?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1100,0]},{"parameters":{"operation":"executeQuery","query":"=SELECT api_proxima_tentativa({{ $('Id da avaliação').first().json.id }}) AS r","options":{}},"id":"48300c31-87f9-57ed-b488-ca52c24cee23","name":"Próxima tentativa","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1320,0],"credentials":{"postgres":{"id":"plataformaPg0001","name":"plataforma"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"d345645c-2dd0-5dd1-b1e8-e1018426d131","leftValue":"={{ $json.r.tentativa_id !== null && $json.r.tentativa_id !== undefined }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"11f37a6c-9e2c-5515-be33-ede85cf85e03","name":"Há pendente?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1540,0]},{"parameters":{"workflowId":{"__rl":true,"value":"PlatExecTentati1","mode":"id"},"options":{"waitForSubWorkflow":true}},"id":"b6c7eb3e-8e24-51b9-96cd-43298b7d112c","